<Window x:Class="Beanfun.GameMaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="楓之谷遊戲檔案管理" Width="820" Height="610"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Foreground="#20262B"
        Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="ExitSprite" TargetType="Button">
      <Setter Property="Width" Value="105"/><Setter Property="Height" Value="44"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Image x:Name="Sprite" Source="/Beanfun;component/Resources/Patcher/bitmap_141.png" Stretch="Fill"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Sprite" Property="Source" Value="/Beanfun;component/Resources/Patcher/bitmap_142.png"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Sprite" Property="Source" Value="/Beanfun;component/Resources/Patcher/bitmap_143.png"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <!-- 第一階段：原本的詳細介面，檢查檔案與選擇更新／修復均在此進行。 -->
    <Border x:Name="DetailsView" Background="#F5F5F5" CornerRadius="12" BorderBrush="#565F64" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#252A2E" CornerRadius="11,11,0,0" MouseLeftButtonDown="DetailHeader_MouseLeftButtonDown">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="×" Width="38" FontSize="20" BorderThickness="0"
                    Background="Transparent" Foreground="White" Cursor="Hand" Click="Close_Click"/>
            <TextBlock Text="楓之谷遊戲檔案管理" Foreground="White" FontWeight="Bold" FontSize="15"
                       Margin="16,0,0,0" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="楓之谷遊戲檔案管理" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
          <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="遊戲路徑：" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="GamePathText" Grid.Column="1" IsReadOnly="True"/>
          </Grid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="本機版本："/><TextBlock x:Name="LocalVersionText" Text="尚未偵測" FontWeight="Bold" Margin="0,0,24,0"/>
            <TextBlock Text="官方版本："/><TextBlock x:Name="OfficialVersionText" Text="尚未取得" FontWeight="Bold" Margin="0,0,24,0"/>
            <TextBlock Text="官方檔案數："/><TextBlock x:Name="FileCountText" Text="-" FontWeight="Bold"/>
          </StackPanel>
          <Border Grid.Row="3" Background="#10000000" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <DockPanel>
              <Button x:Name="UpdateButton" Content="檢查 / 更新遊戲" Width="130" Height="30" DockPanel.Dock="Right" Click="Update_Click"/>
              <TextBlock x:Name="UpdateInfoText" Text="取得官方資訊後會判斷是否有版本更新。" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
          </Border>
          <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <ProgressBar x:Name="Progress" Height="18" Minimum="0" Maximum="100" ValueChanged="Progress_ValueChanged"/>
            <TextBlock x:Name="StatusText" Text="可更新遊戲，或先依官方檔案清單檢查檔案。" Margin="0,5,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <DataGrid x:Name="ResultGrid" Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="狀態" Binding="{Binding StateText}" Width="90"/>
              <DataGridTextColumn Header="檔案" Binding="{Binding Path}" Width="*"/>
              <DataGridTextColumn Header="說明" Binding="{Binding Detail}" Width="220"/>
            </DataGrid.Columns>
          </DataGrid>
          <DockPanel Grid.Row="6" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="CancelButton" Content="取消" Width="80" Margin="5,0" Click="Cancel_Click" IsEnabled="False"/>
              <Button x:Name="RepairButton" Content="修復異常檔案" Width="120" Margin="5,0" Click="Repair_Click" IsEnabled="False"/>
              <Button x:Name="ScanButton" Content="檢查檔案" Width="100" Margin="5,0" Click="Scan_Click"/>
            </StackPanel>
          </DockPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- 第二階段：只顯示原版 Patcher 插畫、進度與 EXIT。 -->
    <Grid x:Name="PatcherView" Width="626" Height="583" Visibility="Collapsed">
      <Image Source="/Beanfun;component/Resources/Patcher/bitmap_139.png" Width="626" Height="583" Stretch="Fill"
             MouseLeftButtonDown="PatcherBackground_MouseLeftButtonDown"/>
      <Grid VerticalAlignment="Bottom" Height="70" Margin="12,0,12,4">
        <Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="PatcherStatusText" Grid.Row="0" FontSize="12" Foreground="#ECECEC" Margin="0,0,112,0"
                   Text="{Binding Text, ElementName=StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   ToolTip="{Binding Text, ElementName=StatusText}"/>
        <Grid x:Name="ProgressTrack" Grid.Row="1" Height="14" Margin="0,0,110,0"
              SizeChanged="ProgressTrack_SizeChanged" ClipToBounds="True">
          <Border Background="#161D20" BorderBrush="#61767B" BorderThickness="1" CornerRadius="5"/>
          <Border x:Name="ProgressFill" Width="0" Height="10" Margin="2,0,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="4">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#5AE7FF" Offset="0"/>
                <GradientStop Color="#00C3F5" Offset="0.45"/>
                <GradientStop Color="#0087CF" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Grid>
        <Grid Grid.Row="2">
          <TextBlock Text="{Binding Value, ElementName=Progress, StringFormat={}{0:0}%}" Foreground="#A7EAF8"
                     VerticalAlignment="Center" Margin="3,0,0,0"/>
        </Grid>
      </Grid>
      <Button x:Name="ExitButton" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,12,9" Style="{StaticResource ExitSprite}" Click="Exit_Click"
              ToolTip="作業中會詢問是否終止；完成後返回詳細介面"/>
    </Grid>
  </Grid>
</Window>
